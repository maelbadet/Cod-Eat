@page
@model IndexModel
@using CodEat.Web
@{ ViewData["Title"] = Model.Tab switch { "recipes"=>"Recettes", "shopping"=>"Courses", "batch"=>"Batch cooking", "settings"=>"Réglages", _=>"Ma semaine" }; }
<div class="heading"><div><p class="eyebrow">TERRE & MER · @Model.Household.Name</p><h1>@ViewData["Title"]</h1><p>Moins d’improvisation. Plus de bons repas.</p></div><div class="weeknav"><a asp-route-Tab="@Model.Tab" asp-route-Date="@Model.Week.Monday.AddDays(-7).ToString("yyyy-MM-dd")" aria-label="Semaine précédente">←</a><details class="week-picker" data-week-picker><summary aria-label="Choisir une semaine">@Model.Week.Monday.ToString("dd MMM") — @Model.Week.Monday.AddDays(6).ToString("dd MMM yyyy") <span aria-hidden="true">⌄</span></summary><form method="get" class="week-picker-panel"><input type="hidden" name="Tab" value="@Model.Tab"/>@foreach(var parameter in Request.Query.Where(x=>x.Key is not ("Date" or "Tab" or "CatalogPage" or "handler"))){foreach(var value in parameter.Value){<input type="hidden" name="@parameter.Key" value="@value"/>}}<label for="week-date">Choisir un jour de la semaine<input id="week-date" name="Date" type="date" value="@Model.Week.Monday.ToString("yyyy-MM-dd")" required data-week-date/></label><p>La semaine du lundi au dimanche sera affichée.</p><div class="week-picker-actions"><a asp-page="Index" asp-route-Tab="@Model.Tab" asp-route-Date="@Kitchen.Today.ToString("yyyy-MM-dd")">Cette semaine</a><button>Afficher</button></div></form></details><a asp-route-Tab="@Model.Tab" asp-route-Date="@Model.Week.Monday.AddDays(7).ToString("yyyy-MM-dd")" aria-label="Semaine suivante">→</a></div></div>
<div asp-validation-summary="All" role="alert"></div><a class="reload" href="@Request.Path@Request.QueryString">Recharger les données</a>
@if(Model.DraftRecipeCount>0 && User.IsInRole("Admin") && Model.Tab is "recipes" or "week"){
<aside class="notice"><strong>Utiliser vos imports sans ouvrir chaque fiche</strong><p>Examinez les fiches complètes puis activez-les en lot pour le planning privé. Elles restent en brouillon avec leurs avertissements.</p><a class="button" asp-page="/Admin/ReviewImports">Examiner et activer les imports en lot</a></aside>
}
@if(Model.Tab=="week"){
<section class="overview" aria-label="Votre semaine en chiffres">
<div class="overview-card"><span class="overview-icon"><svg aria-hidden="true"><use href="/icons.svg#week"/></svg></span><div><strong>@Model.Data.Meals.Count <small>/ 14</small></strong><p>Repas planifiés</p></div></div>
<div class="overview-card"><span class="overview-icon"><svg aria-hidden="true"><use href="/icons.svg#batch"/></svg></span><div><strong>@Model.Data.Preparations.Count</strong><p>@(Model.Data.Preparations.Count == 1 ? "Préparation à cuisiner" : "Préparations à cuisiner")</p></div></div>
<div class="overview-card"><span class="overview-icon"><svg aria-hidden="true"><use href="/icons.svg#shopping"/></svg></span><div><strong>@Model.Data.Shopping.Count(x=>!x.InStock&&!x.Checked)</strong><p>Produits sur votre liste</p></div></div>
</section>
}
@if(Model.DraftRecipeCount > 0 && (Model.Tab == "week" || Model.Tab == "recipes" && Model.ReadyRecipeCount > 0)){
<aside class="notice" aria-label="Recettes à valider"><strong>@Model.DraftRecipeCount fiche(s) en brouillon</strong><p>Ces fiches ne sont pas encore disponibles. Examinez les imports en lot pour activer les fiches complètes dans le planning privé, ou complétez et validez chaque fiche.</p>
@if(User.IsInRole("Admin")){<a asp-page="/Admin/ReviewImports">Examiner les imports en lot</a>}else{<p>Un administrateur doit compléter et valider ces fiches.</p>}
</aside>
}
@if(Model.Tab == "week") {
@if(!string.IsNullOrWhiteSpace(Model.Search+Model.Category+Model.Include+Model.Exclude+Model.Allergens)||Model.MaxKcal!=null||Model.MaxActive!=null||Model.MaxTotal!=null||Model.EquipmentFilter){<p class="notice">Filtres actifs : @Model.Search @Model.Category @Model.Include @Model.Exclude @Model.Allergens @Model.MaxKcal @Model.MaxActive @Model.MaxTotal @(Model.EquipmentFilter?"Mes appareils":"") · <a href="/?Tab=@Model.Tab">Effacer les filtres</a></p>}
<details class="panel filter-panel"><summary>Rechercher et filtrer les recettes · @Model.MatchingRecipeCount résultat(s)</summary><form method="get" class="fields"><input type="hidden" name="Tab" value="@Model.Tab"/><input type="hidden" name="Date" value="@Model.Week.Monday.ToString("yyyy-MM-dd")"/>
<label>Nom<input asp-for="Search" /></label><label>Catégorie<select asp-for="Category"><option value="">Toutes</option><option>Terre</option><option>Mer</option><option>Terre & Mer</option></select></label><label>Kcal maximum<input asp-for="MaxKcal" type="number" min="0" /></label><label>Temps actif maximal (min)<input asp-for="MaxActive" type="number" min="0"/></label><label>Temps total maximal (min)<input asp-for="MaxTotal" type="number" min="0"/></label><label>Ingrédients à inclure (virgules)<input asp-for="Include"/></label><label>Ingrédients à exclure<input asp-for="Exclude"/></label><label>Allergènes à exclure<input asp-for="Allergens"/></label><label class="check"><input asp-for="EquipmentFilter"/>Mes appareils uniquement</label><button>Appliquer les filtres</button><a asp-page="Index" asp-route-Tab="@Model.Tab">Effacer les filtres</a></form></details>
}
@if(Model.Tab=="week") {
<div class="toolbar"><div class="toolbar-title"><h2>Votre planning</h2><p>Choisissez vos repas, on calcule les quantités.</p></div><form method="post"><input type="hidden" name="revision" value="@Model.Week.Revision"/><button class="secondary" name="action" value="suggest" disabled="@(!Model.Recipes.Any())">＋ Proposer des repas</button></form></div>
@if(Model.MatchingRecipeCount>50){<p class="muted">50 recettes proposées sur @Model.MatchingRecipeCount. Utilisez la recherche et les filtres pour choisir dans tout le catalogue.</p>}<div class="days">@for(var d=0;d<7;d++){<section class="day"><h2>@Model.Week.Monday.AddDays(d).ToString("dddd") <small>@Model.Week.Monday.AddDays(d).ToString("dd/MM")</small></h2>@foreach(var slot in new[]{"Midi","Soir"}){var meal=Model.Data.Meals.SingleOrDefault(x=>x.Day==d&&x.Slot==slot);<article class="meal @(meal == null ? "meal-empty" : "meal-planned")"><p class="eyebrow">@slot</p>@if(meal!=null){var prep=Model.Data.Preparations.Single(x=>x.Id==meal.PreparationId);<span class="category-pill" data-category="@prep.Recipe.Category">@prep.Recipe.Category</span><h3><a asp-page="/Preparations/Details" asp-route-WeekId="@Model.Week.Id" asp-route-PreparationId="@prep.Id" asp-route-From="week">@prep.Recipe.Title</a></h3><a class="planned-recipe-link" asp-page="/Preparations/Details" asp-route-WeekId="@Model.Week.Id" asp-route-PreparationId="@prep.Id" asp-route-From="week">Voir la recette complète ↗</a>@if(!prep.Recipe.AllergensVerified){<p class="warning">Allergènes non vérifiés</p>}<p>@meal.Portions portions servies · lot de @prep.Portions</p><form method="post"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="day" value="@d"/><input type="hidden" name="slot" value="@slot"/><button class="quiet" name="action" value="remove">Retirer</button></form><details><summary>Portions / déplacer</summary><form method="post" class="stack"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="preparationId" value="@prep.Id"/><input type="hidden" name="day" value="@d"/><input type="hidden" name="slot" value="@slot"/><label>Portions servies<input name="portions" type="number" min="0.5" step="0.5" value="@(meal.Portions.ToString(System.Globalization.CultureInfo.InvariantCulture))"/></label><button name="action" value="assign">Modifier les portions</button></form><form method="post" class="stack"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="preparationId" value="@prep.Id"/><input type="hidden" name="key" value="@d"/><input type="hidden" name="decision" value="@slot"/><label>Jour de destination<select name="day">@for(int i=0;i<7;i++){<option value="@i">@Model.Week.Monday.AddDays(i).ToString("dddd")</option>}</select></label><label>Créneau<select name="slot"><option>Midi</option><option>Soir</option></select></label><button name="action" value="move">Déplacer et remplacer ce créneau</button></form></details>}else{<p class="empty-label">Créneau libre</p>}
<details><summary>@(meal==null?"+ Ajouter un repas":"Remplacer le repas")</summary><form method="post" class="stack"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="day" value="@d"/><input type="hidden" name="slot" value="@slot"/><label>Recette<select name="recipeId">@foreach(var r in Model.Recipes){<option value="@r.Id">@r.Title</option>}</select></label><label>Ou utiliser un lot existant<select name="preparationId"><option value="@Guid.Empty">Nouvelle préparation</option>@foreach(var p in Model.Data.Preparations){<option value="@p.Id">@p.Recipe.Title — @p.Portions portions préparées</option>}</select></label><label>Portions servies<input name="portions" type="number" value="2" min="0.5" step="0.5"/></label><label>Portions à cuisiner (nouveau lot)<input name="prepared" type="number" value="2" min="0.5" step="0.5"/></label><button name="action" value="assign" disabled="@(!Model.Recipes.Any() && !Model.Data.Preparations.Any())">Enregistrer ce repas</button></form></details></article>}</section>}</div>
}
@if(Model.Tab=="recipes"){<partial name="_RecipeBrowser" model="Model"/>}
@if(Model.Tab=="shopping") {
<div class="toolbar"><a href="#verification">À vérifier avant d’exporter (@Model.Reminders.Count)</a><button id="copy-list" type="button" class="secondary">Copier la liste</button><a href="#exports" class="button">Télécharger la liste de courses</a></div><textarea id="copy-text" class="sr-only" aria-label="Liste de courses au format texte">@Model.CopyText</textarea><p id="copy-status" role="status"></p>
@foreach(var group in Model.Data.Shopping.GroupBy(x=>x.Aisle)){<section class="panel"><h2>@group.Key</h2>@foreach(var line in group){<form method="post" class="shoppingline"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="key" value="@line.Key"/><input type="hidden" name="action" value="line"/><label class="product"><input type="checkbox" name="bought" value="true" checked="@line.Checked" data-submit/>@line.Name <span>@(line.Adjusted ?? line.Calculated) @line.Unit</span></label><details class="line-options"><summary>Ajuster</summary><div class="line-controls"><label>Quantité ajustée<input name="quantity" type="number" step="0.001" min="0" value="@(line.Adjusted?.ToString(System.Globalization.CultureInfo.InvariantCulture))"/></label><button class="quiet" name="decision" value="stock">@(line.InStock?"En stock ✓":"Déjà en stock")</button><button name="decision" value="acheter">Enregistrer</button></div></details>@if(line.Changed){<p class="warning">Quantité calculée modifiée : @line.Calculated @line.Unit. Confirmez votre décision.</p>}@if(line.Note!=""){<p class="warning">@line.Note</p>}</form>}</section>}
<form method="post" class="panel fields"><h2>Ajouter un produit</h2><input type="hidden" name="revision" value="@Model.Week.Revision"/><label>Produit<input name="name" required/></label><label>Quantité<input name="quantity" type="number" min="0" step="0.001"/></label><label>Unité<input name="unit"/></label><label>Rayon<input name="aisle" value="Divers"/></label><button name="action" value="manual">Ajouter aux courses</button></form>
<section class="panel" id="verification"><h2>À vérifier avant d’exporter</h2>@if(!Model.Reminders.Any()){<p>Aucun rappel en attente.</p>}@foreach(var r in Model.Reminders){<form method="post" class="toolbar reminder-actions"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="reminderId" value="@r.Id"/><input type="hidden" name="action" value="reminder"/><p><strong>@r.Product</strong> · @r.Quantity @r.Unit</p><button name="decision" value="Ajouter">Ajouter aux courses</button><button class="quiet" name="decision" value="Stock">Déjà en stock</button><button class="quiet" name="decision" value="Reporter">Reporter</button></form>}</section>
}
@if(Model.Tab=="batch") {<div class="toolbar"><p>Un lot, plusieurs repas. Préparez l’essentiel le dimanche.</p><a href="#exports" class="button">Télécharger le planning des repas</a><button id="print" type="button">Vue imprimable</button></div>@foreach(var p in Model.Data.Preparations){<section class="panel"><p class="eyebrow">PRÉPARATION UNIQUE</p><h2><a asp-page="/Preparations/Details" asp-route-WeekId="@Model.Week.Id" asp-route-PreparationId="@p.Id" asp-route-From="batch">@p.Recipe.Title</a></h2><a class="button secondary" asp-page="/Preparations/Details" asp-route-WeekId="@Model.Week.Id" asp-route-PreparationId="@p.Id" asp-route-From="batch">Ouvrir la recette complète</a><p>@p.Portions portions à cuisiner · @Model.Data.Meals.Where(x=>x.PreparationId==p.Id).Sum(x=>x.Portions) affectées</p><p>@(p.Carryover?"Restes de la semaine précédente · ingrédients déjà comptés":"") Actif : @p.Recipe.ActiveMinutes min · cuisson : @p.Recipe.CookMinutes min · total : @p.Recipe.TotalMinutes min</p><p>Ustensiles : @p.Recipe.Equipment</p>@if(p.ReservedAfterWeek>0 || p.Carryover){<p class="notice">Lot partagé entre deux semaines : date et quantité conservées. Les ingrédients sont comptés dans la semaine de cuisson.</p>}<ul>@foreach(var m in Model.Data.Meals.Where(x=>x.PreparationId==p.Id)){<li>@Model.Week.Monday.AddDays(m.Day).ToString("dddd dd/MM") @m.Slot : @m.Portions portions</li>}</ul><form method="post" class="fields"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="preparationId" value="@p.Id"/><label>Préparer le (Europe/Paris)<input type="datetime-local" name="at" value="@p.At.ToString("yyyy-MM-ddTHH:mm")" required/></label><label>Portions à cuisiner<input name="prepared" type="number" step="0.5" min="0.5" value="@(p.Portions.ToString(System.Globalization.CultureInfo.InvariantCulture))"/></label><label class="check"><input name="frozen" type="checkbox" value="true" checked="@p.Frozen"/>Prévoir une congélation</label><button name="action" value="prepare" disabled="@(p.Carryover || p.ReservedAfterWeek>0)">Enregistrer la préparation</button></form><p>Réfrigérateur : @(p.Recipe.FridgeHours?.ToString()??"inconnu") h · Congélation : @(p.Recipe.Freezable?"possible":"non validée")</p><p>@p.Recipe.Thaw @p.Recipe.Reheat</p>@foreach(var warning in Kitchen.Warnings(p,Model.Data,Model.Week.Monday)){<p class="warning">Attention : @warning</p>}</section>}<section class="panel"><h2>Pour toute la session</h2><p>Temps actifs cumulés : @Model.Data.Preparations.Where(x=>!x.Carryover).Sum(x=>x.Recipe.ActiveMinutes??0) min. Ce cumul exclut les temps inconnus et n’est pas la durée réelle de la session.</p><p>@string.Join(", ",Model.Data.Preparations.SelectMany(x=>x.Recipe.Equipment.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries)).Distinct())</p></section>}
@if(Model.Tab=="settings") {
<form method="post" class="panel stack"><h2>Mes appareils</h2><input type="hidden" name="revision" value="@Model.Week.Revision"/><label>Appareils disponibles (séparés par des virgules)<input name="equipment" value="@Model.Household.Equipment"/></label><button name="action" value="equipment">Enregistrer les appareils</button></form>
<section class="panel"><h2>Produits récurrents</h2>@foreach(var rule in Model.Rules){<form method="post" class="toolbar"><input type="hidden" name="revision" value="@Model.Week.Revision"/><input type="hidden" name="reminderId" value="@rule.Id"/><p>@rule.Product : @rule.Quantity @rule.Unit tous les @rule.EveryMonths mois · hiver @rule.WinterQuantity · automne @rule.AutumnQuantity</p><button name="action" value="delete-rule">Supprimer pour remplacer la règle</button></form>}<form method="post" class="fields"><input type="hidden" name="revision" value="@Model.Week.Revision"/><label>Produit<input name="name" required/></label><label>Unité<input name="unit" value="boîte"/></label><label>Quantité habituelle<input name="quantity" type="number" value="1" min="0.01" step="0.01"/></label><label>Cadence en mois<input name="cadence" type="number" value="1" min="1" max="12"/></label><label>Quantité hiver<input name="winter" type="number" step="0.01"/></label><label>Quantité automne<input name="autumn" type="number" step="0.01"/></label><label>Mois prioritaire (1–12)<input name="month" type="number" min="1" max="12"/></label><label>Quantité de ce mois<input name="monthQuantity" type="number" step="0.01"/></label><button name="action" value="rule">Créer la règle</button></form></section>
<form method="post" class="panel"><h2>Inviter le second membre</h2><p>Lien à usage unique, valable 48 heures. Transmettez-le vous-même à la personne invitée.</p><input type="hidden" name="revision" value="@Model.Week.Revision"/><button name="action" value="invite">Créer une invitation</button>@if(TempData["Invitation"] is string invitation){<p class="prewrap">@invitation</p>}</form>
}
@if(Model.Tab is "week" or "shopping" or "batch") {<section class="panel" id="exports"><h2>Finaliser et retrouver les PDF</h2><p>Chaque finalisation conserve une copie des repas, des courses et des deux documents.</p><form method="post" class="stack"><input type="hidden" name="revision" value="@Model.Week.Revision"/><label class="check"><input name="confirm" type="checkbox" value="true"/>Inclure les éléments encore à vérifier dans l’export</label><button name="action" value="finalize">Finaliser une nouvelle version et créer les PDF</button></form>@foreach(var v in Model.Versions){<p>Version @v.Version · @TimeZoneInfo.ConvertTimeFromUtc(v.CreatedUtc,Kitchen.Paris).ToString("dd/MM/yyyy HH:mm") <a asp-page-handler="Pdf" asp-route-id="@v.Id" asp-route-kind="shopping">Télécharger la liste de courses</a> · <a asp-page-handler="Pdf" asp-route-id="@v.Id" asp-route-kind="meals">Télécharger le planning des repas</a></p>}</section>}





