@page "/catalogue/{id:int?}/{slug?}"
@model CodEat.Web.Pages.Public.CatalogModel
@if(Model.Recipe==null){<form method="get" class="panel fields"><label>Rechercher une recette<input asp-for="Search"/></label><button>Rechercher</button></form>}
@if(Model.Recipe is {} r){<article class="recipebody"><partial name="Shared/_RecipePhoto" model="r"/><p class="eyebrow">@r.Collection · @r.Category</p><h1>@r.Title</h1><p>@ViewData["Description"]</p><p>@r.Servings portions · actif : @(r.ActiveMinutes?.ToString()??"inconnu") min · cuisson : @(r.CookMinutes?.ToString()??"inconnue") min · total : @(r.TotalMinutes?.ToString()??"inconnu") min</p>@if(r.Kcal.HasValue){<p>@r.Kcal kcal par portion (@r.KcalSource)</p>}<section class="panel"><h2>Ingrédients</h2><ul>@foreach(var ingredient in r.Ingredients){<li>@ingredient.Quantity @ingredient.Unit @ingredient.Canonical @ingredient.Comment</li>}</ul></section><section class="panel"><h2>Préparation</h2><div class="prewrap">@r.Steps</div></section><p>Allergènes déclarés : @(string.IsNullOrEmpty(r.Allergens)?"aucun":r.Allergens)</p><p>Ustensiles : @r.Equipment</p><a href="/catalogue">Toutes les recettes Terre &amp; Mer</a></article>@if(Model.JsonLd!=null){<script type="application/ld+json">@Html.Raw(Model.JsonLd)</script>}}else{<p class="eyebrow">LA COLLECTION COD & EAT</p><h1>Terre &amp; Mer : les recettes</h1><p>Des idées pour la semaine, les ingrédients et les étapes pour passer en cuisine.</p><div class="cards">@foreach(var recipe in Model.Recipes){<article class="panel"><a class="recipe-photo-link" href="/catalogue/@recipe.Id/@recipe.Slug"><partial name="Shared/_RecipePhoto" model="recipe"/></a><p class="eyebrow">@recipe.Category</p><h2><a href="/catalogue/@recipe.Id/@recipe.Slug">@recipe.Title</a></h2><p>@recipe.Description</p><p>@recipe.Servings portions · @(recipe.TotalMinutes?.ToString()??"?") min</p></article>}</div>@if(Model.Recipes.Count==0){<p>Aucune recette publiée pour le moment.</p>}}
@if(Model.Recipe==null){<nav class="toolbar" aria-label="Pages du catalogue public"><span>@Model.Total recettes · page @Model.CatalogPage / @Model.Pages</span>
@if(Model.CatalogPage>1){<a asp-route-CatalogPage="@(Model.CatalogPage-1)" asp-route-Search="@Model.Search">Précédente</a>}
@if(Model.CatalogPage<Model.Pages){<a asp-route-CatalogPage="@(Model.CatalogPage+1)" asp-route-Search="@Model.Search">Suivante</a>}
</nav>}

